# Copy to .env and fill in. .env is git-ignored.

# Congress.gov API key (free): https://api.congress.gov/sign-up/
CONGRESS_KEY=

# PostgreSQL connection (development and test)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Local LLM for AI member summaries (https://ollama.com). Run `ollama pull <model>` first.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

VOTE_LIMIT=100
